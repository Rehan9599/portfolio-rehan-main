.for_business_banner[_ngcontent-ng-c878393820] .container[_ngcontent-ng-c878393820] { position: relative; display: flex; flex-direction: column; gap: 4px; z-index: 1; color: var(--grey-1100); }

.for_business_banner[_ngcontent-ng-c878393820] .container[_ngcontent-ng-c878393820] .title[_ngcontent-ng-c878393820] { font-size: 16px; font-weight: 700; }

